<?xml version="1.0" encoding="utf-8"?>
<!-- The Windows launcher (KytyLauncher.exe): a settings window in front of run-windows.ps1 and precompile-windows.ps1.
     .NET Framework 4.7.2 (part of Windows 10 since 1803 and of Windows 11), WPF. build.cmd builds it with Visual Studio's MSBuild. -->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{6B7E3E0A-2C4D-4F7B-9E1A-5A3C8D2F1B47}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>KytyLauncher</RootNamespace>
    <AssemblyName>KytyLauncher</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <ProjectTypeGuids>{60dc8134-eba5-43b8-bcc9-bb4bc16c2548};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <WarningLevel>4</WarningLevel>
    <LangVersion>7.3</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>launcher.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath Condition=" '$(OutputPath)' == '' ">..\_Build\launcher\</OutputPath>
    <IntermediateOutputPath>..\_Build\launcher-obj\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="Theme.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="CheatsWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="CheatsWindow.xaml.cs">
      <DependentUpon>CheatsWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="Settings.cs" />
    <Compile Include="KeyboardPrompts.cs" />
    <Compile Include="KeyboardLayout.cs" />
    <Compile Include="PromptTexture.cs" />
    <Compile Include="PageMarks.cs" />
    <Compile Include="KeyboardControlsWindow.cs" />
    <!-- The prompt textures are kept gzipped here and embedded unpacked (KeyboardPromptsUnpack below). Embedded
         compressed data that the program unpacks and writes to disk is what Malwarebytes' machine-learning check flagged
         (MachineLearning/Anomalous, every launcher from v20261105 on); the same data embedded unpacked is not flagged. -->
    <KeyboardPromptPacked Include="KeyboardPrompts\*.gz" />
    <EmbeddedResource Include="KeyboardPrompts\manifest.txt">
      <WithCulture>false</WithCulture>
      <LogicalName>KytyLauncher.KeyboardPrompts.manifest.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="@(KeyboardPromptPacked->'$(IntermediateOutputPath)KeyboardPrompts\%(Filename)')">
      <WithCulture>false</WithCulture>
      <LogicalName>KytyLauncher.KeyboardPrompts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Compile Include="Platform.cs" />
    <Compile Include="Game.cs" />
    <Compile Include="Commands.cs" />
    <Compile Include="Strings.cs" />
    <Compile Include="FolderPicker.cs" />
    <Compile Include="AssemblyInfo.cs" />
    <None Include="app.manifest" />
    <Resource Include="launcher.ico" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <UsingTask TaskName="KeyboardPromptsGunzip" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Folder ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(Folder);
        foreach (var file in Files) {
          using (var input = new GZipStream(File.OpenRead(file.ItemSpec), CompressionMode.Decompress))
          using (var output = File.Create(Path.Combine(Folder, Path.GetFileNameWithoutExtension(file.ItemSpec))))
            input.CopyTo(output);
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <!-- KeyboardPrompts\*.gz unpacked into the intermediate folder, where the EmbeddedResource items above take them. -->
  <Target Name="KeyboardPromptsUnpack" BeforeTargets="BeforeBuild" Inputs="@(KeyboardPromptPacked)"
          Outputs="@(KeyboardPromptPacked->'$(IntermediateOutputPath)KeyboardPrompts\%(Filename)')">
    <KeyboardPromptsGunzip Files="@(KeyboardPromptPacked)" Folder="$(IntermediateOutputPath)KeyboardPrompts" />
  </Target>
  <Target Name="KeyboardPromptsFileWrites" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <FileWrites Include="@(KeyboardPromptPacked->'$(IntermediateOutputPath)KeyboardPrompts\%(Filename)')" />
    </ItemGroup>
  </Target>
</Project>
